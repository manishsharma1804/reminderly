{
  "manifest_version": 3,
  "name": "Reminderly – Smart Reminder Assistant",
  "short_name": "Reminderly",
  "version": "1.0.18",
  "description": "Intelligent, context-aware reminder assistant with Focus Mode, Website Blocker, Remi Assistant, and Analytics Dashboard.",
  "icons": {
    "16": "icons/16x16.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    },
    "default_title": "Reminderly Dashboard"
  },
  "options_page": "dashboard/dashboard.html",
  "background": {
    "service_worker": "js/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "tabs",
    "activeTab",
    "scripting",
    "webNavigation",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://manishsharma1804.github.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "css/content.css",
        "css/mascot.css"
      ],
      "js": [
        "js/content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "css/*",
        "js/*",
        "dashboard/*",
        "remi/*",
        "offscreen/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "add_quick_reminder": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "Add New Quick Reminder"
    },
    "toggle_focus_mode": {
      "suggested_key": {
        "default": "Alt+F",
        "mac": "Alt+F"
      },
      "description": "Start / Toggle Focus Session"
    },
    "open_dashboard": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "Open Full Dashboard"
    }
  }
}